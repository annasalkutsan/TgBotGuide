FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
USER $APP_UID
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["TgBotGuide.Infrastructure.Bot/TgBotGuide.Infrastructure.Bot.csproj", "TgBotGuide.Infrastructure.Bot/"]
COPY ["TgBotGuide.Application/TgBotGuide.Application.csproj", "TgBotGuide.Application/"]
COPY ["TgBotGuide.Domain/TgBotGuide.Domain.csproj", "TgBotGuide.Domain/"]
COPY ["TgBotGuide.Infrastructure.Refit/TgBotGuide.Infrastructure.Refit.csproj", "TgBotGuide.Infrastructure.Refit/"]
RUN dotnet restore "TgBotGuide.Infrastructure.Bot/TgBotGuide.Infrastructure.Bot.csproj"
COPY . .
WORKDIR "/src/TgBotGuide.Infrastructure.Bot"
RUN dotnet build "TgBotGuide.Infrastructure.Bot.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "TgBotGuide.Infrastructure.Bot.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "TgBotGuide.Infrastructure.Bot.dll"]
